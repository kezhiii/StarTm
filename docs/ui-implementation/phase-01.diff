@@ -0,0 +1,106 @@
+// 编队局部放大窗：用真实 RTN 相对位置画三星构型。
+// 只做显示增强——读数据、画到小 canvas 上，绝不把任何坐标写回三维场景或轨道根数。
+import { loadCategory, getValue } from './loader.js?v=34';
+
+const COLORS = ['#7fe3d6', '#6fa8dc', '#e8a33d'];
+const PAIRS = [[0, 1, 'TM0S1–TM0S2'], [1, 2, 'TM0S2–TM0S3'], [2, 0, 'TM0S3–TM0S1']];
+
+let entry = null, host = null, cv = null, ctx = null, foot = null;
+let peStep = 60;            // preview 文件的采样间隔，从数据里读，不写死
+let onSelect = null;
+let hit = [];               // 屏幕命中区：{x, y, sat}
+
+async function ensure() {
+    if (entry) return entry;
+    try { entry = await loadCategory('formation_rtn'); } catch (e) { return null; }
+    const s1 = Number(getValue(entry, 1, 1, 'rel_s'));
+    peStep = Number.isFinite(s1) && s1 > 0 ? s1 : 60;
+    return entry;
+}
+
+/** 取某仿真秒的三星 RTN 相对位置（km），相对第一颗星 */
+function relAt(simSeconds) {
+    const i = Math.max(0, Math.min(Math.floor(simSeconds / peStep), entry.nEpoch - 1));
+    const pts = [];
+    for (const sat of entry.satIds) {
+        const r = [getValue(entry, i, sat, 'R'), getValue(entry, i, sat, 'T'), getValue(entry, i, sat, 'N')]
+            .map(v => Number(v));
+        if (!r.every(Number.isFinite)) return null;
+        pts.push(r);
+    }
+    if (pts.length < 3) return null;
+    const o = pts[0];
+    return pts.map(p => [p[0] - o[0], p[1] - o[1], p[2] - o[2]]);   // [dR, dT, dN]
+}
+
+function fit(w, h) {
+    const dpr = window.devicePixelRatio || 1;
+    if (cv.width !== Math.round(w * dpr) || cv.height !== Math.round(h * dpr)) {
+        cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr);
+    }
+    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+    ctx.clearRect(0, 0, w, h);
+}
+
+/** 投影到屏幕：水平 = T（沿迹），垂直 = R（径向，向上为正）；N 用数值标注 */
+export async function renderInset(simSeconds) {
+    if (!host) return;
+    if (!cv) {
+        cv = host.querySelector('canvas'); ctx = cv && cv.getContext('2d');
+        foot = host.querySelector('.fi-ft');
+        if (!cv || !ctx) return;
+        cv.addEventListener('click', e => {
+            const r = cv.getBoundingClientRect();
+            const p = hit.find(q => Math.hypot(q.x - (e.clientX - r.left), q.y - (e.clientY - r.top)) < 12);
+            if (p && onSelect) onSelect(p.sat);
+        });
+    }
+    const w = cv.clientWidth, h = cv.clientHeight;
+    if (!w || !h) return;
+    await ensure();
+    fit(w, h);
+    const cx = w / 2, cy = h / 2;
+    if (!entry) { note(cx, cy, '数据未加载'); foot.textContent = 'formation_rtn 未提供'; return; }
+    const rel = relAt(simSeconds);
+    if (!rel) { note(cx, cy, '该时刻无 RTN 数据'); foot.textContent = '相对位置未提供'; return; }
+
+    // 自适应比例：让三点外加余量正好铺进小窗
+    const span = Math.max(1e-6, ...rel.flatMap(p => [Math.abs(p[0]), Math.abs(p[1])]),
+        ...PAIRS.map(([a, b]) => Math.hypot(rel[a][0] - rel[b][0], rel[a][1] - rel[b][1])));
+    const k = Math.min(w, h) * 0.34 / span;
+    const sx = p => cx + p[1] * k;          // T → 右
+    const sy = p => cy - p[0] * k;          // R → 上
+    hit = [];
+
+    ctx.lineWidth = 1; ctx.strokeStyle = 'rgba(120,150,175,.45)';
+    const dists = [];
+    for (const [a, b] of PAIRS) {
+        ctx.beginPath(); ctx.moveTo(sx(rel[a]), sy(rel[a])); ctx.lineTo(sx(rel[b]), sy(rel[b])); ctx.stroke();
+        dists.push(Math.hypot(rel[a][0] - rel[b][0], rel[a][1] - rel[b][1], rel[a][2] - rel[b][2]));
+    }
+    rel.forEach((p, i) => {
+        const x = sx(p), y = sy(p);
+        hit.push({ x, y, sat: i + 1 });
+        ctx.fillStyle = COLORS[i % 3];
+        ctx.beginPath(); ctx.arc(x, y, 4.5, 0, Math.PI * 2); ctx.fill();
+        ctx.font = '11px "Microsoft YaHei", sans-serif'; ctx.textAlign = 'center';
+        ctx.fillText(`TM0S${i + 1}`, x, y - 9);
+    });
+    ctx.fillStyle = '#6a8095'; ctx.font = '10.5px Consolas, monospace'; ctx.textAlign = 'left';
+    ctx.fillText('T→  R↑', 6, h - 6);
+    ctx.textAlign = 'right';
+    ctx.fillText(`N: ${rel[1][2].toFixed(2)} / ${rel[2][2].toFixed(2)} km`, w - 6, h - 6);
+    // 三条边长放进页脚一行，不画在三角形里：小窗内三角形只有几十像素宽，
+    // 数字压在星名上会互相糊掉（上一轮审查就是这么发现的）。
+    foot.textContent = `S12 ${dists[0].toFixed(3)} · S23 ${dists[1].toFixed(3)} · S31 ${dists[2].toFixed(3)} km`;
+    foot.title = 'S12=TM0S1–TM0S2，S23=TM0S2–TM0S3，S31=TM0S3–TM0S1；单位 km，采样 ' + peStep + ' s';
+}
+
+function note(cx, cy, t) {
+    ctx.fillStyle = '#8ba0b3'; ctx.font = '11.5px "Microsoft YaHei", sans-serif';
+    ctx.textAlign = 'center'; ctx.fillText(t, cx, cy);
+}
+
+export function initInset(el, hooks) {
+    host = el; onSelect = hooks && hooks.onSelect;
+}
