+// 场景配置抽屉 / 保存 / 加载 / 导出。
+// 原则：只把数据里真存在的参数做成字段；没有的一律显示「未提供」，
+// 不做假输入框，也不给没有依据的取值范围。重跑按钮在引擎接好前保持禁用。
+import { loadCategory, getValue, getStepSec } from './loader.js?v=34';
+
+const $ = (id) => document.getElementById(id);
+
+// 物理定义域，不是我们自创的工程限值：半长轴必须大于地球半径、偏心率在 [0,1)、
+// 倾角 [0,180]、三个角度 [0,360)。
+const RE = 6378.137;
+const OE_FIELDS = [
+    { key: 'a0',      name: '半长轴 a₀',      unit: 'km',  min: RE + 100, max: 50000, step: 0.001 },
+    { key: 'e0',      name: '偏心率 e₀',       unit: '',    min: 0,        max: 0.999, step: 0.0001 },
+    { key: 'inc0_deg', name: '倾角 i₀',        unit: '°',   min: 0,        max: 180,   step: 0.001 },
+    { key: 'raan0_deg', name: '升交点赤经 Ω₀', unit: '°',   min: 0,        max: 360,   step: 0.001 },
+    { key: 'argp0_deg', name: '近地点幅角 ω₀', unit: '°',   min: 0,        max: 360,   step: 0.001 },
+    { key: 'nu0_deg',  name: '真近点角 ν₀',    unit: '°',   min: 0,        max: 360,   step: 0.001 },
+];
+
+let meta = null, duty = null, ident = null;
+let base = {};          // 加载到的原始值，「恢复默认」用
+let cur = {};           // 当前编辑值
+let dirty = false;
+let hooks = {};
+
+function fmtNum(v, step) {
+    const dp = step >= 1 ? 0 : step >= 0.01 ? 2 : 4;
+    return Number(v).toFixed(dp);
+}
+
+function validate() {
+    const errs = [];
+    for (const sat of Object.keys(cur.oe || {})) {
+        for (const f of OE_FIELDS) {
+            const v = cur.oe[sat][f.key];
+            if (v === '' || v === null || !Number.isFinite(Number(v))) { errs.push(`${sat} ${f.name}：不是数字`); continue; }
+            const x = Number(v);
+            if (x < f.min || x > f.max) errs.push(`${sat} ${f.name}：${x} 超出定义域 ${f.min}–${f.max} ${f.unit}`);
+        }
+    }
+    return errs;
+}
+
+function rowHtml(sat, f) {
+    const v = cur.oe[sat][f.key];
+    return `<tr><td class="name">${f.name}</td>` +
+        `<td><input class="fnum" data-sat="${sat}" data-key="${f.key}" type="number"
+            step="${f.step}" value="${v}" aria-label="${sat} ${f.name}"></td>` +
+        `<td class="unit">${f.unit || '—'}</td></tr>`;
+}
+
+function renderBody() {
+    const host = $('drawerBody');
+    const sats = Object.keys(cur.oe || {});
+    const missing = (why) => `<tr><td class="name" colspan="3"><span class="miss">未提供 · ${why}</span></td></tr>`;
+    const ro = (k, v, u) => `<tr><td class="name">${k}</td><td class="val">${v ?? '—'}</td><td class="unit">${u || ''}</td></tr>`;
+
+    host.innerHTML = `
+<details open><summary>① 轨道与编队<span class="r">${sats.length} 颗</span></summary><div class="inner">
+  <table class="ftable">${sats.map(s => `<tr class="grp"><td colspan="3">${s}</td></tr>` + OE_FIELDS.map(f => rowHtml(s, f)).join('')).join('')}
+  ${ro('仿真时长', (meta?.rows_per_sat ? meta.rows_per_sat * 1 : null) + ' s', '')}
+  ${ro('采样间隔', getStepSec() + ' s', '')}
+  </table></div></details>
+
+<details open><summary>② 姿态与太阳翼<span class="r">只读</span></summary><div class="inner"><table class="ftable">
+  ${ro('运行工况', ident?.mode ?? '未提供', '')}
+  ${ro('姿态模式（数据里的取值）', ident?.attMode ?? '未提供', '')}
+  ${ro('太阳翼展开轴', '±Y_B（结构方案给定）', '')}
+  </table></div></details>
+
+<details open><summary>③ 能源系统<span class="r">未提供</span></summary><div class="inner"><table class="ftable">
+  ${missing('power 的 5 列整列为空，battery_soc_pct 列不存在，需能源模型交付时序')}
+  ${ro('电池容量', null, 'Ah')}${ro('初始 SOC', null, '%')}${ro('发电功率参数', null, 'W')}
+  </table></div></details>
+
+<details open><summary>④ 设备功耗与启停<span class="r">${duty ? duty.length : 0} 台</span></summary><div class="inner">
+  ${duty ? `<table class="ftable"><tr class="grp"><td>设备</td><td>正常功耗</td><td>发热量</td></tr>` +
+      duty.slice(0, 12).map(d => `<tr><td class="name">${d.equip_name}</td>` +
+        `<td class="val">${d.normal_w || '—'} W</td>` +
+        `<td class="val">${d.heat_w || '未提供'}</td></tr>`).join('') +
+      `</table>${duty.length > 12 ? `<div class="more">仅列前 12 台，共 ${duty.length} 台</div>` : ''}`
+    : missing('equipment_duty.csv 未载入')}
+  </div></details>
+
+<details open><summary>⑤ 热控参数<span class="r">未提供</span></summary><div class="inner"><table class="ftable">
+  ${missing('thermal 的 4 列整列为空，逐测点 temp_<node> 列未交付，需热控模型交付时序')}
+  ${ro('初始温度', null, '℃')}${ro('热参数', null, '—')}${ro('主动热控', null, '—')}
+  </table></div></details>`;
+
+    host.querySelectorAll('input.fnum').forEach(inp => {
+        inp.addEventListener('input', () => {
+            cur.oe[inp.dataset.sat][inp.dataset.key] = inp.value;
+            setDirty(true);
+            paintErrors();
+        });
+    });
+    paintErrors();
+}
+
+function paintErrors() {
+    const errs = validate();
+    $('drawerErr').innerHTML = errs.length
+        ? `<ul>${errs.map(e => `<li>${e}</li>`).join('')}</ul>` : '';
+    $('btnApply').disabled = true;      // 引擎未接通，无论校验是否通过都不可重跑
+    return errs;
+}
+
+function setDirty(v) {
+    dirty = v;
+    $('drawerDirty').hidden = !v;
+    $('btnApply').disabled = true;
+}
+
+function openDrawer(group) {
+    $('drawer').hidden = false;
+    $('drawerMask').hidden = false;
+    document.body.classList.add('drawer-open');
+    if (group) {
+        const d = [...$('drawerBody').querySelectorAll('details')]
+            .find(x => x.textContent.startsWith(group));
+        if (d) { d.open = true; d.scrollIntoView({ block: 'start' }); }
+    }
+    $('btnDrawerClose').focus();
+}
+function closeDrawer(force) {
+    if (dirty && !force && !confirm('配置有未应用更改，确定放弃？')) return;
+    setDirty(false);
+    $('drawer').hidden = true; $('drawerMask').hidden = true;
+    document.body.classList.remove('drawer-open');
+}
+
+async function ensureData() {
+    if (!meta) meta = await (await fetch('/sim-data/meta.json')).json();
+    if (!cur.oe) {
+        cur.oe = JSON.parse(JSON.stringify(meta.oe_input || {}));
+        base = JSON.parse(JSON.stringify(meta.oe_input || {}));
+    }
+    if (!ident) {
+        try {
+            const e = await loadCategory('time_ident');
+            ident = { mode: getValue(e, 0, 1, 'mode'), mission: getValue(e, 0, 1, 'mission') };
+            const a = await loadCategory('attitude');
+            const seen = new Set();
+            for (let ep = 0; ep < a.nEpoch && seen.size < 4; ep += 600) {
+                const v = getValue(a, ep, 1, 'att_mode'); if (v) seen.add(v);
+            }
+            ident.attMode = [...seen].join(' / ') || null;
+        } catch (e) { ident = ident || {}; }
+    }
+    if (duty === null) {
+        try {
+            const t = await (await fetch('/sim-data/preview/equipment_duty.csv')).text();
+            const lines = t.split(/\r?\n/).filter(l => l && !l.startsWith('#'));
+            const h = lines[0].split(',');
+            const iN = h.indexOf('equip_name'), iP = h.indexOf('normal_w'), iH = h.indexOf('heat_w');
+            duty = lines.slice(1).map(l => { const v = l.split(','); return {
+                equip_name: v[iN], normal_w: v[iP], heat_w: v[iH] }; });
+        } catch (e) { duty = []; }
+    }
+}
+
+export function snapshot(extra) {
+    return {
+        场景格式版本: 'serproject-scenario/1',
+        场景标识: ident ? [ident.mission, ident.mode].filter(Boolean).join(' · ') : null,
+        起算时刻: extra?.t0ISO || null,
+        总时长_s: meta?.rows_per_sat ?? null,
+        采样间隔_s: getStepSec(),
+        观察站: meta?.station || null,
+        轨道根数_初始: cur.oe,
+        未提供分组: ['能源系统（power 列为空）', '热控参数（temp_* 列未交付）'],
+        显示偏好: extra?.prefs || null,
+        有未应用更改: dirty,
+    };
+}
+
+export function initSceneIO(h) {
+    hooks = h || {};
+    $('btnDrawerClose').onclick = () => closeDrawer();
+    $('drawerMask').onclick = () => closeDrawer();
+    $('btnRestore').onclick = async () => {
+        await ensureData();
+        cur.oe = JSON.parse(JSON.stringify(base));
+        renderBody(); setDirty(true);
+        hooks.toast && hooks.toast('已恢复为数据加载时的初始根数（尚未应用）');
+    };
+    $('btnCancel').onclick = () => closeDrawer();
+    $('btnApply').onclick = () => { /* 引擎未接通，按钮恒禁用，这里不会被调到 */ };
+    $('btnLoad').onclick = () => $('loadFile').click();
+    $('loadFile').onchange = async (e) => {
+        const f = e.target.files && e.target.files[0];
+        if (!f) return;
+        try {
+            const txt = await f.text();
+            const j = JSON.parse(txt);
+            if (j['场景格式版本'] !== 'serproject-scenario/1') throw new Error('场景格式版本不是 serproject-scenario/1');
+            if (!j['轨道根数_初始'] || typeof j['轨道根数_初始'] !== 'object') throw new Error('缺少「轨道根数_初始」');
+            if (dirty && !confirm('当前有未应用更改，加载会覆盖，继续？')) { e.target.value = ''; return; }
+            await ensureData();
+            cur.oe = j['轨道根数_初始'];
+            renderBody();
+            const errs = validate();
+            if (errs.length) { hooks.toast && hooks.toast('文件已读入但字段不合法：' + errs[0], true); }
+            else hooks.toast && hooks.toast(`已加载场景文件「${f.name}」，参数已编辑但尚未应用（重跑引擎未接入）`);
+            setDirty(true);
+        } catch (err) {
+            hooks.toast && hooks.toast('加载失败：' + err.message + '（界面保持原状态）', true);
+        }
+        e.target.value = '';
+    };
+    for (const [id, grp] of [['cfgOrbit', '①'], ['cfgAtt', '②'], ['cfgPower', '③'], ['cfgThermal', '⑤']]) {
+        const el = $(id);
+        if (!el) continue;
+        el.onclick = async () => { await ensureData(); renderBody(); openDrawer(grp); };
+    }
+}
